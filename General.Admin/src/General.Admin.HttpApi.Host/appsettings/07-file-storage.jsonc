{
  "FileStorage": {
    // Provider: Local | AliyunOSS | MinIO
    // 企业私有化优先用 MinIO；公有云上阿里云 OSS 可直接切换 AliyunOSS。
    "Provider": "Local",
    "MaxFileSizeBytes": 104857600, // 100MB
    // 默认白名单由 PlatformFileContentTypes 维护；如确需覆盖或放开，可在此添加 AllowedContentTypes。
    "Local": {
      "RootPath": "App_Data/upload-files",
      "PathTemplate": ""
      // Example: "{yyyy}/{MM}/{dd}"
    },
    "AliyunOSS": {
      // Provider = "AliyunOSS" 时启用。
      "Endpoint": "oss-cn-hangzhou.aliyuncs.com",
      "Region": "cn-hangzhou",
      "BucketName": "general-admin",
      "AccessKeyId": "",
      "AccessKeySecret": "",
      "UseHttps": true,
      "CustomDomain": "",
      "PathTemplate": "{yyyy}/{MM}/{dd}"
    },
    "MinIO": {
      // Provider = "MinIO" 时启用。
      "Endpoint": "127.0.0.1:9000",
      "Region": "",
      "BucketName": "general-admin",
      "AccessKey": "",
      "SecretKey": "",
      "UseSSL": false,
      "CustomDomain": "",
      "PathTemplate": "{yyyy}/{MM}/{dd}"
    }
  }
}
