# 复制为 .env.local 后按本地环境修改；真实密钥和个人环境值不要提交。
VITE_APP_NAME=General Admin

# Vite静态资源部署路径，不是Vue Router路径，也不是API地址。
VITE_ASSET_BASE=/

# SPA路由部署路径；G03接入Vue Router时读取。
VITE_ROUTER_BASE=/

# 浏览器请求使用的API前缀；同源反向代理场景使用 /api。
VITE_API_BASE_URL=/api

# 本地开发代理目标，来自General.Admin.HttpApi.Host launchSettings；不含密钥。
VITE_API_PROXY_TARGET=http://127.0.0.1:5010
